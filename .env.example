# =============================================================================
# Front Office — AI receptionist for Saudi clinics
# Copy to .env and fill in. Every variable that has a default is marked.
# =============================================================================

# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info                       # debug | info | warn | error

# Public URL of the API service. Telegram and the widget call back to this.
PUBLIC_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------ agent
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5        # default: claude-opus-5
ANTHROPIC_EFFORT=medium              # low | medium | high  (default: medium)
ANTHROPIC_MAX_TOKENS=2048            # default: 2048

# --------------------------------------------------------------- database
# `file`  — zero-setup JSON store, for local development and the offline demo.
# `supabase` — Postgres. Required in production.
STORE_DRIVER=file
FILE_STORE_PATH=.data/demo.json

# Supabase project settings → API. The service role key bypasses RLS, so it
# must never be exposed to a browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ------------------------------------------------- data protection (PDPL)
# Patient names, phone numbers, message bodies and appointment notes are
# encrypted at rest with AES-256-GCM using this key.
#   generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Salt for the deterministic phone-number lookup hash. Changing it orphans
# existing patient lookups, so set it once and keep it.
#   generate: openssl rand -hex 32
PHONE_HASH_SALT=

# ------------------------------------------------------------------ auth
# Shared key the dashboard uses to call the admin API.
#   generate: openssl rand -hex 32
ADMIN_API_KEY=

# Password for the dashboard sign-in screen.
DASHBOARD_PASSWORD=

# Shared secret for the scheduled-job endpoints (/jobs/tick, /jobs/nightly).
#   generate: openssl rand -hex 32
CRON_SECRET=

# --------------------------------------------------------------- clinics
CLINICS_DIR=clinics
DEFAULT_CLINIC_SLUG=noor-riyadh

# --------------------------------------------------------------- Telegram
# From @BotFather. See README → "Telegram bot registration".
TELEGRAM_BOT_TOKEN=123456789:AA...
# Any random string; Telegram echoes it back on every webhook call.
#   generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# Running several clinics from one deployment? Add per-clinic overrides using
# the clinic slug in upper snake case, e.g. for slug `noor-riyadh`:
# TELEGRAM_BOT_TOKEN_NOOR_RIYADH=...
# TELEGRAM_WEBHOOK_SECRET_NOOR_RIYADH=...

# --------------------------------------------------------------- WhatsApp
# NOT ENABLED. The adapter is fully implemented in
# packages/core/src/messaging/channels/whatsapp.ts and switches on when
# ENABLE_WHATSAPP=true and these are set. Requires Meta Business verification.
# See docs/MESSAGING.md.
ENABLE_WHATSAPP=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ------------------------------------------------------------------ jobs
# Run reminders and the retention purge inside the API process. Set to false
# when a platform scheduler drives POST /jobs/tick and /jobs/nightly instead.
ENABLE_INPROCESS_JOBS=true

# ------------------------------------------------------------- dashboard
# Read by apps/dashboard (Next.js). Point API_BASE_URL at the API service.
API_BASE_URL=http://localhost:8080
